{
  "name": "portafolio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --use-system-ca node_modules/next/dist/bin/next dev",
    "prebuild": "node -e \"require('fs').rmSync('.next/cache', { recursive: true, force: true })\"",
    "build": "node --use-system-ca node_modules/next/dist/bin/next build",
    "typecheck": "tsc --noEmit",
    "test": "node --test lib/projects.test.ts"
  },
  "dependencies": {
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2"
  }
}
